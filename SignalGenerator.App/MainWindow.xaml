<Window x:Class="SignalGenerator.App.MainWindow"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SignalGenerator.App"
        mc:Ignorable="d"
        Title="MainWindow" Height="810" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScottPlot:WpfPlot x:Name="WpfPlot1" />
        <StackPanel Grid.Row="1" Grid.Column="0">
            <StackPanel Height="40" Orientation="Horizontal">
                <Label Content="Порог" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="ThresholdTextBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0" Margin="10,10,0,0"
                    Height="20" Width="50"/>
                <Button
                    Content="Найти пересечения"
                    HorizontalAlignment="Left"
                    Width="120"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Click="Button_Click_FindCrossings"/>
                <Button
                    Content="Очистить маркеры"
                    HorizontalAlignment="Left"
                    Width="120"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Click="Button_Click_ClearMarkers"/>
            </StackPanel>
            <TextBlock x:Name="SummaryTextBlock" Margin="10,0,0,0"/>
            <TextBlock x:Name="CounterTextBlock" Margin="10,0,0,0"/>
            <TextBlock x:Name="PeriodTextBlock" Margin="10,0,0,0"/>
            <ListBox x:Name="MarkerListBox" Height="150" Margin="10,5,10,10"/>
        </StackPanel>
        <DockPanel Grid.Column="1" Grid.RowSpan="2" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" Height="50" Orientation="Horizontal">
                <Label Content="Длительность(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="len_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="5" Margin="10,10,0,0"
     Height="20" Width="50"/>
                <Label Content="Частота(Гц)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="freq_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="10" Margin="10,10,0,0"
Height="20" Width="50"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Height="50" Orientation="Horizontal">
                <ComboBox x:Name="SignalTypeComboBox" VerticalAlignment="Top" Margin="10,10,0,0" Width="100"
                    SelectionChanged="SignalTypeComboBox_SelectionChanged"/>
                <Button
                    Content="Сгенерировать"
                    HorizontalAlignment="Left"
                    Width="100"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Click="Button_Click_Generate"/>
            </StackPanel>
            <StackPanel x:Name="SinePanel" DockPanel.Dock="Top">
                <StackPanel Height="47" Orientation="Horizontal">
                    <Label Content="Период(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="period_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                    <Label Content="Фаза(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="phase_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="10" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                </StackPanel>
                <StackPanel Height="47" Orientation="Horizontal">
                    <Label Content="Коэффициент" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="scale_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="LinePanel" DockPanel.Dock="Top" Height="47" Orientation="Horizontal">
                <Label Content="k" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="k_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
             Height="20" Width="50"/>
                <Label Content="b" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="b_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="-2" Margin="10,10,0,0"
Height="20" Width="50"/>

            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button
        Content="Сброс"
        HorizontalAlignment="Left"
        Width="70"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
        Click="Button_Clear"/>

                <Button
        Content="Удалить"
        HorizontalAlignment="Left"
        Width="70"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
                    Click="Button_Click_Remove"/>
                <Button
Content="Загрузить"
HorizontalAlignment="Left"
Width="70"
Margin="10,10,0,0"
VerticalAlignment="Top"
            Click="Button_Load"/>
                <Button
Content="Сохранить"
HorizontalAlignment="Left"
Width="70"
Margin="10,10,0,0"
VerticalAlignment="Top"
            Click="Button_Write"/>

            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button
        Content="Сумма"
        HorizontalAlignment="Left"
        Width="70"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
                    Click="Button_Click_Summ"/>

                <Button
        Content="Склейка"
        HorizontalAlignment="Left"
        Width="70"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
                    Click="Button_Click_Concat"/>


            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button
        Content="Изменить частоту"
        HorizontalAlignment="Left"
        Width="110"
        Margin="10,10,0,0"
        VerticalAlignment="Top"
                    Click="Button_Click_Resample"/>
                <Label Content="Новая частота(Гц)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="newFreq_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="20" Margin="10,10,0,0"
                    Height="20" Width="50"/>
            </StackPanel>
            <StackPanel x:Name="NoisePanel" DockPanel.Dock="Top" Orientation="Horizontal" Height="50">
                <Label Content="Размах" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="Amplitude_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
                    Height="20" Width="50"/>
            </StackPanel>
            <StackPanel x:Name="SawPanel" DockPanel.Dock="Top">
                <StackPanel Height="47" Orientation="Horizontal">
                    <Label Content="Период(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="saw_period_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                    <Label Content="Фаза(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="saw_phase_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                </StackPanel>
                <StackPanel Height="47" Orientation="Horizontal">
                    <Label Content="Амплитуда" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="saw_amplitude_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="TrianglePanel" DockPanel.Dock="Top">
                <StackPanel Height="47" Orientation="Horizontal">
                    <Label Content="Период(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="triangle_period_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                    <Label Content="Фаза(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="triangle_phase_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                </StackPanel>
                <StackPanel Height="47" Orientation="Horizontal">
                    <Label Content="Амплитуда" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="triangle_amplitude_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="MeanderPanel" DockPanel.Dock="Top">
                <StackPanel Height="47" Orientation="Horizontal">
                    <Label Content="Период(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="meander_period_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                    <Label Content="Фаза(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="meander_phase_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                </StackPanel>
                <StackPanel Height="47" Orientation="Horizontal">
                    <Label Content="Амплитуда" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="meander_amplitude_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                    <Label Content="Скважность" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="meander_duty_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0.5" Margin="10,10,0,0"
                        Height="20" Width="50"/>
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button
Content="Оф.фильтр"
HorizontalAlignment="Right"
Width="70"
Margin="10,10,0,0"
VerticalAlignment="Top"
            Click="Button_Click_Offline"/>
                <Label Content="Окно(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="Window_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0.5" Margin="10,10,0,0"
                Height="20" Width="50"/>
                <Button
Content="Он.фильтр"
HorizontalAlignment="Left"
Width="70"
Margin="10,10,0,0"
VerticalAlignment="Top"
            Click="Button_Click_Online"/>


            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Label Content="Тип фильтра" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <ComboBox x:Name="filterType_comboBox" VerticalAlignment="Top" Margin="10,10,0,0" Width="100" SelectedIndex="0">
                    <ComboBoxItem Content="Среднее"/>
                    <ComboBoxItem Content="Медиана"/>
                </ComboBox>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">

                <Label Content="upCut" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="upCut_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="-2" Margin="10,10,0,0"
Height="20" Width="50"/>
                <Label Content="downCut" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="downCut_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="-2" Margin="10,10,0,0"
Height="20" Width="50"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button
                    Content="CutUp"
                    HorizontalAlignment="Right"
                    Width="70"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Click="Button_Click_CutUp"/>




                <Button
                    Content="CutDown"
                    HorizontalAlignment="Right"
                    Width="70"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Click="Button_Click_CutDown"/>

            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">

                    <Button
                    Content="CutUpAndDown"
                    HorizontalAlignment="Right"
                    Width="100"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Click="Button_Click_CutUpAndDown"/>



            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button
                    Content="Зашкалы"
                    HorizontalAlignment="Left"
                    Width="70"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Click="Button_Click_Analyze"/>
                <Button
                    Content="Сохр.разм."
                    HorizontalAlignment="Left"
                    Width="70"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Click="Button_Write_Markup"/>
                <Button
                    Content="Загр.разм."
                    HorizontalAlignment="Left"
                    Width="70"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Click="Button_Load_Markup"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Label Content="Мин.:" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="min_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="-0.8" Margin="10,10,0,0"
                    Height="20" Width="40"/>
                <Label Content="Макс.:" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="max_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0.8" Margin="10,10,0,0"
                    Height="20" Width="40"/>
                <Label Content="Длит.(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="duration_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0.2" Margin="10,10,0,0"
                    Height="20" Width="40"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
